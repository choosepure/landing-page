{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/admin\\.html",
      "dest": "server.js"
    },
    {
      "src": "/(admin-login|admin-forgot-password|admin-reset-password)\\.html",
      "status": 308,
      "headers": { "Location": "https://api.choosepure.in/$1.html" }
    },
    {
      "src": "/admin",
      "status": 308,
      "headers": { "Location": "https://api.choosepure.in/admin" }
    },
    {
      "src": "/admin/(.*)",
      "status": 308,
      "headers": { "Location": "https://api.choosepure.in/admin/$1" }
    },
    {
      "src": "/api/(.*)",
      "dest": "https://api.choosepure.in/api/$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
